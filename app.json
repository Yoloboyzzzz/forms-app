{
  "expo": {
    "name": "Forms",
    "slug": "ucll-mobile-starter",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ucllstarter",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Forms",
      "shortName": "Forms",
      "themeColor": "#1d4ed8",
      "backgroundColor": "#ffffff",
      "display": "standalone"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "description": "Fill in the forms assigned to you, or build and review forms as an admin.",
    "icon": "./assets/icon.png"
  }
}
